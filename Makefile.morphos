# Fuse 1.9.2 + libspectrum 1.6.4 native MorphOS build.
#
# Same role/layout as Makefile.morphos in the openMSX MorphOS port:
#   make -f Makefile.morphos
#   make -f Makefile.morphos -j4
#   make -f Makefile.morphos strip
#   make -f Makefile.morphos package
#
# Everything generated by this wrapper is kept under derived/.

FUSE_SRC ?= fuse-1.9.2
LIBSPECTRUM_SRC ?= libspectrum-1.6.4
PYTHON ?= python3

# Native MorphOS SDK / GCC 9 defaults. Command-line assignments still
# override these, e.g. CC=gcc or CC=ppc-morphos-gcc for another setup.
CC = gcc-9
AR = ar
RANLIB = ranlib
STRIP = strip
CATCOMP ?= CatComp

ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
DERIVED ?= $(ROOT)/derived
LIBSPECTRUM_BUILD := $(DERIVED)/libspectrum
FUSE_BUILD := $(DERIVED)/fuse
PREFIX := $(DERIVED)/root
BUNDLE_DIR ?= $(ROOT)/Fuse-MorphOS
PACKAGE_BUILD ?= $(DERIVED)/package
PACKAGE_DIR := $(PACKAGE_BUILD)/Fuse
PACKAGE_LHA ?= $(ROOT)/Fuse.lha
LHA ?= LhA
FUSE_RAW := $(FUSE_BUILD)/fuse
FUSE_DB := $(FUSE_BUILD)/Fuse.db
FUSE_BIN := $(FUSE_BUILD)/Fuse
FUSE_ICON_SRC := $(ROOT)/$(FUSE_SRC)/data/icons/128x128/net.sourceforge.fuse_emulator.Fuse.png
LOCALE_SRC := $(ROOT)/$(FUSE_SRC)/ui/morphos
CATALOGS_SRC := $(LOCALE_SRC)/catalogs
LOCALE_BUILD := $(DERIVED)/locale
POLISH_CT := $(CATALOGS_SRC)/polski/Fuse.ct
POLISH_CATALOG := $(LOCALE_BUILD)/polski/Fuse.catalog
CATCOMP_CD_REL := $(FUSE_SRC)/ui/morphos/Fuse.cd
CATCOMP_CT_REL := $(FUSE_SRC)/ui/morphos/catalogs/polski/Fuse.ct
CATCOMP_CATALOG_REL := derived/locale/polski/Fuse.catalog
BOOTDEVICE ?= SYS:
GEN_ROOT := $(ROOT)/morphos-generated
ALTIVEC_SRC := $(ROOT)/$(FUSE_SRC)/ui/morphos/morphosvideo_altivec.c
ALTIVEC_HDR := $(ROOT)/$(FUSE_SRC)/ui/morphos/morphosvideo_altivec.h
ALTIVEC_OBJ := $(DERIVED)/morphosvideo_altivec.o

# Optional include override for an unpacked MorphOS SDK include tree.
# Normally leave this empty when the compiler already knows the SDK sysroot.
MORPHOS_INCLUDE ?=

# Match the native ABI/SDK model used by the openMSX MorphOS port.
TARGET_FLAGS ?= -noixemul -D__MORPHOS__ -D__PPC__ -D__MORPHOS_SHAREDLIBS -D_NO_PPCINLINE
COMPILE_FLAGS ?= -O2 -g -Wall -Wextra -fstack-usage -Wstack-usage=8192 -Wframe-larger-than=8192
LINK_FLAGS ?= -noixemul
FUSE_LINK_FLAGS ?= $(LINK_FLAGS)
NM ?= nm

# MorphOS video profile: Surface + CGXVideo Overlay + optional TinyGL.
# MorphOS zlib uses z_shared; PNG stays off. AHI audio is enabled. Accelerated renderers fall back TinyGL -> Overlay -> Surface.
MORPHOS_DEBUG ?= 0
MORPHOS_LIBS ?= -lz_shared -lGL

ifeq ($(MORPHOS_DEBUG),1)
MORPHOS_DEBUG_CFLAGS := -DFUSE_MORPHOS_DEBUG
MORPHOS_DEBUG_LIBS := -ldebug
else
MORPHOS_DEBUG_CFLAGS :=
MORPHOS_DEBUG_LIBS :=
endif

FUSE_RUNTIME_LIBS := $(ALTIVEC_OBJ) $(MORPHOS_LIBS) $(MORPHOS_DEBUG_LIBS)
LIBSPECTRUM_SYSTEM_LIBS ?= -lz_shared

AUDIO_DRIVER ?= ahi
FUSE_CONFIGURE_EXTRA ?=
LIBSPECTRUM_CONFIGURE_EXTRA ?=

ifneq ($(strip $(MORPHOS_INCLUDE)),)
MORPHOS_CPPFLAGS := -I$(MORPHOS_INCLUDE)
else
MORPHOS_CPPFLAGS :=
endif

MORPHOS_CFLAGS := $(TARGET_FLAGS) $(COMPILE_FLAGS) $(MORPHOS_DEBUG_CFLAGS)
# Keep VMX out of the baseline binary code paths: only this one object is
# compiled with AltiVec enabled and runtime dispatch decides whether to call it.
ALTIVEC_FLAGS ?= -O3 -maltivec -fno-tree-vectorize

BUILD_ENV = \
	CC="$(CC)" CC_FOR_BUILD="$(CC)" AR="$(AR)" RANLIB="$(RANLIB)" PKG_CONFIG="" \
	CPPFLAGS="$(MORPHOS_CPPFLAGS)" \
	CFLAGS="$(MORPHOS_CFLAGS)" \
	LDFLAGS="$(LINK_FLAGS)"

# Fuse's configure script normally discovers libspectrum through pkg-config.
# MorphOS SDKs often do not ship pkg-config, so feed the same flags directly.
# Setting PKG_CONFIG empty also prevents configure from accidentally using an
# unrelated host-side pkg-config when this tree is cross-built elsewhere.
LIBSPECTRUM_CFLAGS ?= -I$(PREFIX)/include
LIBSPECTRUM_LIBS ?= -L$(PREFIX)/lib -lspectrum -lz_shared -lm
FUSE_DEP_ENV = \
	LIBSPECTRUM_CFLAGS="$(LIBSPECTRUM_CFLAGS)" \
	LIBSPECTRUM_LIBS="$(LIBSPECTRUM_LIBS)"

LIBSPECTRUM_PC := $(PREFIX)/lib/pkgconfig/libspectrum.pc
LIBSPECTRUM_PREP := $(LIBSPECTRUM_BUILD)/.morphos-prepared
FUSE_PREP := $(FUSE_BUILD)/.morphos-prepared

# This MorphOS package ships pre-generated Autoconf/Automake outputs.  The
# native SDK should not need automake/autoconf/aclocal/m4/Perl just because a
# patched Makefile.am has a newer archive timestamp than Makefile.in.
FUSE_AUTOTOOLS_STAMP := $(ROOT)/$(FUSE_SRC)/.morphos-autotools-frozen
FUSE_AUTOTOOLS_INPUTS := \
	$(ROOT)/$(FUSE_SRC)/configure.ac \
	$(ROOT)/$(FUSE_SRC)/Makefile.am \
	$(ROOT)/$(FUSE_SRC)/ui/morphos/Makefile.am

.PHONY: all toolchain-check libspectrum build debug fuse audit catalog install-catalog bundle package-dir package strip info clean distclean reconfigure

all: toolchain-check strip

toolchain-check:
	@command -v "$(CC)" >/dev/null 2>&1 || { echo "ERROR: $(CC) not found"; exit 1; }
	@command -v "$(AR)" >/dev/null 2>&1 || { echo "ERROR: $(AR) not found"; exit 1; }
	@command -v "$(RANLIB)" >/dev/null 2>&1 || { echo "ERROR: $(RANLIB) not found"; exit 1; }
	@echo "MorphOS compiler:"; "$(CC)" --version

$(LIBSPECTRUM_BUILD)/config.status: $(LIBSPECTRUM_SRC)/configure
	@mkdir -p "$(LIBSPECTRUM_BUILD)" "$(PREFIX)"
	cd "$(LIBSPECTRUM_BUILD)" && $(BUILD_ENV) LIBS="$(LIBSPECTRUM_SYSTEM_LIBS)" \
		"$(ROOT)/$(LIBSPECTRUM_SRC)/configure" \
		--host=ppc-morphos \
		--prefix="$(PREFIX)" \
		--disable-shared \
		--enable-static \
		--with-fake-glib \
		--without-bzip2 \
		--without-libgcrypt \
		--without-libaudiofile \
		--with-wav-backend=none \
		$(LIBSPECTRUM_CONFIGURE_EXTRA)

$(LIBSPECTRUM_PREP): $(LIBSPECTRUM_BUILD)/config.status
	# Keep Automake stamp-h1 from making config.h look freshly remade on every
	# invocation (which would force regeneration of Perl-built files).
	touch "$(LIBSPECTRUM_BUILD)/config.h"
	# Build only the tiny generator helper (C + cat, no Perl), then put the
	# pre-generated minimal-SDK files in the build tree with fresh timestamps.
	$(MAKE) -C "$(LIBSPECTRUM_BUILD)" make-perl generate.pl
	cp "$(GEN_ROOT)/libspectrum/libspectrum.h" "$(LIBSPECTRUM_BUILD)/libspectrum.h"
	cp "$(ROOT)/$(LIBSPECTRUM_SRC)/snap_accessors.c" \
	   "$(ROOT)/$(LIBSPECTRUM_SRC)/tape_accessors.c" \
	   "$(ROOT)/$(LIBSPECTRUM_SRC)/tape_set.c" "$(LIBSPECTRUM_BUILD)/"
	mkdir -p "$(LIBSPECTRUM_BUILD)/test"
	cp "$(GEN_ROOT)/libspectrum/test/complete-tzx.tzx" \
	   "$(GEN_ROOT)/libspectrum/test/wav-mono-threshold.wav" \
	   "$(GEN_ROOT)/libspectrum/test/wav-stereo-mixdown.wav" \
	   "$(LIBSPECTRUM_BUILD)/test/"
	touch "$@"

$(LIBSPECTRUM_PC): $(LIBSPECTRUM_PREP)
	$(MAKE) -C "$(LIBSPECTRUM_BUILD)"
	$(MAKE) -C "$(LIBSPECTRUM_BUILD)" install

libspectrum: toolchain-check $(LIBSPECTRUM_PC)

$(FUSE_AUTOTOOLS_STAMP): $(FUSE_AUTOTOOLS_INPUTS) $(ROOT)/Makefile.morphos
	@echo "Freezing pre-generated Fuse autotools files (no automake/autoconf required)"
	# Keep dependency order explicit: aclocal.m4 after its m4/configure inputs,
	# configure/config.h.in after aclocal.m4, and Makefile.in last after Makefile.am.
	touch "$(ROOT)/$(FUSE_SRC)/aclocal.m4"
	touch "$(ROOT)/$(FUSE_SRC)/configure" "$(ROOT)/$(FUSE_SRC)/config.h.in"
	touch "$(ROOT)/$(FUSE_SRC)/Makefile.in"
	touch "$@"

$(ALTIVEC_OBJ): $(ALTIVEC_SRC) $(ALTIVEC_HDR) $(ROOT)/Makefile.morphos
	@mkdir -p "$(DERIVED)"
	$(CC) $(MORPHOS_CPPFLAGS) $(TARGET_FLAGS) $(COMPILE_FLAGS) $(ALTIVEC_FLAGS) \
		-c "$(ALTIVEC_SRC)" -o "$@"

$(FUSE_BUILD)/config.status: $(ALTIVEC_OBJ) $(FUSE_AUTOTOOLS_STAMP) $(FUSE_SRC)/configure $(FUSE_SRC)/ltmain.sh $(LIBSPECTRUM_PC) $(ROOT)/Makefile.morphos
	@mkdir -p "$(FUSE_BUILD)"
	cd "$(FUSE_BUILD)" && $(FUSE_DEP_ENV) $(BUILD_ENV) LDFLAGS="$(FUSE_LINK_FLAGS)" LIBS="$(FUSE_RUNTIME_LIBS)" \
		"$(ROOT)/$(FUSE_SRC)/configure" \
		--host=ppc-morphos \
		--prefix="$(PREFIX)" \
		--with-morphos \
		--without-sdl \
		--disable-sdl2 \
		--disable-sdltest \
		--without-gtk \
		--without-libxml2 \
		--without-png \
		--without-pthread \
		--disable-sockets \
		--with-joystick \
		--with-audio-driver="$(AUDIO_DRIVER)" \
		$(FUSE_CONFIGURE_EXTRA)

$(FUSE_PREP): $(FUSE_BUILD)/config.status
	touch "$(FUSE_BUILD)/config.h"
	# Upstream Fuse normally regenerates these through Perl.  For the fixed
	# MorphOS configuration used by this wrapper, ship/copy known generated
	# inputs so a normal SDK build needs no Perl interpreter.
	mkdir -p "$(FUSE_BUILD)/ui/widget" "$(FUSE_BUILD)/z80"
	cp "$(GEN_ROOT)/fuse/options.h" "$(FUSE_BUILD)/options.h"
	cp "$(ROOT)/$(FUSE_SRC)/settings.c" "$(ROOT)/$(FUSE_SRC)/settings.h" "$(FUSE_BUILD)/"
	cp "$(GEN_ROOT)/fuse/ui/widget/fuse.font" \
	   "$(GEN_ROOT)/fuse/ui/widget/menu_data.c" \
	   "$(GEN_ROOT)/fuse/ui/widget/options.c" \
	   "$(GEN_ROOT)/fuse/ui/widget/options_internals.h" \
	   "$(FUSE_BUILD)/ui/widget/"
	cp "$(ROOT)/$(FUSE_SRC)/z80/opcodes_base.c" \
	   "$(ROOT)/$(FUSE_SRC)/z80/z80_cb.c" \
	   "$(ROOT)/$(FUSE_SRC)/z80/z80_ddfd.c" \
	   "$(ROOT)/$(FUSE_SRC)/z80/z80_ddfdcb.c" \
	   "$(ROOT)/$(FUSE_SRC)/z80/z80_ed.c" "$(FUSE_BUILD)/z80/"
	touch "$@"

build debug: toolchain-check $(FUSE_PREP)
	$(FUSE_DEP_ENV) $(MAKE) -C "$(FUSE_BUILD)"
	@mkdir -p "$(FUSE_BUILD)/roms" "$(FUSE_BUILD)/lib"
	@cp "$(ROOT)/$(FUSE_SRC)"/roms/*.rom "$(FUSE_BUILD)/roms/"
	@cp "$(ROOT)/$(FUSE_SRC)"/lib/keyboard.scr \
	    "$(ROOT)/$(FUSE_SRC)"/lib/keyboard.png \
	    "$(ROOT)/$(FUSE_SRC)"/lib/cassette.bmp \
	    "$(ROOT)/$(FUSE_SRC)"/lib/microdrive.bmp \
	    "$(ROOT)/$(FUSE_SRC)"/lib/plus3disk.bmp "$(FUSE_BUILD)/lib/"
	@cp -f "$(FUSE_RAW)" "$(FUSE_DB)"
	@echo "ROMs: $(FUSE_BUILD)/roms (PROGDIR:roms/)"
	@echo "Data: $(FUSE_BUILD)/lib (PROGDIR:lib/)"
	@if command -v "$(NM)" >/dev/null 2>&1; then \
	  "$(NM)" -n "$(FUSE_DB)" > "$(FUSE_BUILD)/Fuse.map"; \
	  echo "Symbol map: $(FUSE_BUILD)/Fuse.map"; \
	fi
	@echo
	@echo "Fuse MorphOS debug binary: $(FUSE_DB)"

strip: build
	@command -v "$(STRIP)" >/dev/null 2>&1 || { echo "ERROR: $(STRIP) not found"; exit 1; }
	$(STRIP) --strip-unneeded -R .comment "$(FUSE_DB)" -o "$(FUSE_BIN)"
	@echo "Fuse MorphOS stripped binary: $(FUSE_BIN)"

fuse: strip

audit:
	$(PYTHON) "$(ROOT)/tests/audit_morphos.py" "$(ROOT)/$(FUSE_SRC)"


# CatComp locale layout intentionally follows RDesktopGui in the source tree:
#   ui/morphos/Fuse.cd
#   ui/morphos/catalogs/polski/Fuse.ct  (ISO-8859-2 / MIBenum 5)
# The runtime/package layout is the standard application-local form:
#   Fuse/Catalogs/Fuse.cd
#   Fuse/Catalogs/polski/Fuse.ct
#   Fuse/Catalogs/polski/Fuse.catalog
# The checked-in Fuse_strings.h keeps the English fallback build independent
# of CatComp; CatComp is only needed to build the binary Polish catalog.
# Native MorphOS CatComp uses dos.library path handling.  Do not pass the
# POSIX-style absolute paths produced by GNU make's $(abspath), e.g.
# /Programy/Emulatory/..., because native CatComp reports those as an object
# not found.  Change to the project root first and give CatComp only relative
# paths.
catalog:
	@mkdir -p "$(LOCALE_BUILD)/polski"
	@if command -v "$(CATCOMP)" >/dev/null 2>&1; then \
		cd "$(ROOT)" || exit 1; \
		test -f "$(CATCOMP_CD_REL)" || { echo "ERROR: missing $(CATCOMP_CD_REL)"; exit 1; }; \
		test -f "$(CATCOMP_CT_REL)" || { echo "ERROR: missing $(CATCOMP_CT_REL)"; exit 1; }; \
		echo "CatComp: building polski/Fuse.catalog"; \
		echo "  CD:      $(CATCOMP_CD_REL)"; \
		echo "  CT:      $(CATCOMP_CT_REL)"; \
		echo "  CATALOG: $(CATCOMP_CATALOG_REL)"; \
		"$(CATCOMP)" "$(CATCOMP_CD_REL)" "$(CATCOMP_CT_REL)" \
			CATALOG "$(CATCOMP_CATALOG_REL)"; \
	else \
		echo "CatComp not found: skipping binary Fuse.catalog (English fallback remains built in)"; \
	fi

install-catalog: catalog
	@if test -f "$(POLISH_CATALOG)"; then \
		mkdir -p "$(BOOTDEVICE)MorphOS/Locale/Catalogs/polski"; \
		cp -f "$(POLISH_CATALOG)" "$(BOOTDEVICE)MorphOS/Locale/Catalogs/polski/Fuse.catalog"; \
		echo "Installed: $(BOOTDEVICE)MorphOS/Locale/Catalogs/polski/Fuse.catalog"; \
	else \
		echo "ERROR: Polish Fuse.catalog was not built"; exit 1; \
	fi

# Build a ready-to-run PROGDIR: tree.  Keep translation sources in the
# distribution too: translators get Catalogs/Fuse.cd and each language keeps
# its own .ct below Catalogs/<language>/.
package-dir: strip catalog
	@if test ! -f "$(POLISH_CATALOG)"; then \
		echo "ERROR: $(POLISH_CATALOG) is required for a complete package"; \
		echo "       Install/use MorphOS CatComp and run make package again."; \
		exit 1; \
	fi
	rm -rf "$(PACKAGE_DIR)"
	mkdir -p "$(PACKAGE_DIR)/roms" "$(PACKAGE_DIR)/lib" \
	         "$(PACKAGE_DIR)/ui/widget" "$(PACKAGE_DIR)/settings" \
	         "$(PACKAGE_DIR)/Catalogs/polski"
	cp "$(FUSE_BIN)" "$(PACKAGE_DIR)/Fuse"
	cp "$(FUSE_ICON_SRC)" "$(PACKAGE_DIR)/Fuse.info"
	cp "$(ROOT)/$(FUSE_SRC)"/roms/*.rom "$(PACKAGE_DIR)/roms/"
	@if test -f "$(ROOT)/$(FUSE_SRC)/roms/README.copyright"; then \
		cp "$(ROOT)/$(FUSE_SRC)/roms/README.copyright" "$(PACKAGE_DIR)/roms/"; \
	fi
	cp "$(ROOT)/$(FUSE_SRC)"/lib/keyboard.scr \
	   "$(ROOT)/$(FUSE_SRC)"/lib/keyboard.png \
	   "$(ROOT)/$(FUSE_SRC)"/lib/cassette.bmp \
	   "$(ROOT)/$(FUSE_SRC)"/lib/microdrive.bmp \
	   "$(ROOT)/$(FUSE_SRC)"/lib/plus3disk.bmp "$(PACKAGE_DIR)/lib/"
	cp "$(FUSE_BUILD)/ui/widget/fuse.font" "$(PACKAGE_DIR)/ui/widget/fuse.font"
	cp "$(LOCALE_SRC)/Fuse.cd" "$(PACKAGE_DIR)/Catalogs/Fuse.cd"
	cp "$(POLISH_CT)" "$(PACKAGE_DIR)/Catalogs/polski/Fuse.ct"
	cp "$(POLISH_CATALOG)" "$(PACKAGE_DIR)/Catalogs/polski/Fuse.catalog"
	@if test -f "$(CATALOGS_SRC)/polski/ENCODING.txt"; then \
		cp "$(CATALOGS_SRC)/polski/ENCODING.txt" "$(PACKAGE_DIR)/Catalogs/polski/"; \
	fi
	@if test -f "$(CATALOGS_SRC)/README-TRANSLATORS.txt"; then \
		cp "$(CATALOGS_SRC)/README-TRANSLATORS.txt" "$(PACKAGE_DIR)/Catalogs/"; \
	fi
	@if test -f "$(ROOT)/Fuse.readme"; then \
		cp "$(ROOT)/Fuse.readme" "$(PACKAGE_DIR)/Fuse.readme"; \
	fi
	@if test -f "$(ROOT)/Fuse_MorphOS_prefs.example"; then \
		cp "$(ROOT)/Fuse_MorphOS_prefs.example" "$(PACKAGE_DIR)/"; \
	fi
	@if test -f "$(ROOT)/$(FUSE_SRC)/COPYING"; then \
		cp "$(ROOT)/$(FUSE_SRC)/COPYING" "$(PACKAGE_DIR)/COPYING"; \
	fi
	@echo "Runnable MorphOS package tree: $(PACKAGE_DIR)/"

# Backwards-compatible unpacked bundle target.
bundle: package-dir
	rm -rf "$(BUNDLE_DIR)"
	cp -R "$(PACKAGE_DIR)" "$(BUNDLE_DIR)"
	@echo "Runnable MorphOS bundle: $(BUNDLE_DIR)/"

# MorphOS-only distribution archive.  -e keeps the empty settings directory,
# -x/-r preserve paths and recurse, and H1 avoids old header-0 path limits.
package: package-dir
	@command -v "$(LHA)" >/dev/null 2>&1 || { echo "ERROR: MorphOS LhA not found"; exit 1; }
	rm -f "$(PACKAGE_LHA)"
	cd "$(PACKAGE_BUILD)" && "$(LHA)" -e -x -r -H1 a "$(PACKAGE_LHA)" Fuse
	@echo "MorphOS package: $(PACKAGE_LHA)"

info:
	@echo "FUSE_SRC=$(FUSE_SRC)"
	@echo "LIBSPECTRUM_SRC=$(LIBSPECTRUM_SRC)"
	@echo "CC=$(CC)"
	@echo "DERIVED=$(DERIVED)"
	@echo "PREFIX=$(PREFIX)"
	@echo "MORPHOS_INCLUDE=$(MORPHOS_INCLUDE)"
	@echo "CFLAGS=$(MORPHOS_CFLAGS)"
	@echo "MORPHOS_DEBUG=$(MORPHOS_DEBUG)"
	@echo "LDFLAGS=$(LINK_FLAGS)"
	@echo "LIBS=$(FUSE_RUNTIME_LIBS)"
	@echo "LIBSPECTRUM_CFLAGS=$(LIBSPECTRUM_CFLAGS)"
	@echo "LIBSPECTRUM_LIBS=$(LIBSPECTRUM_LIBS)"
	@echo "LIBSPECTRUM_SYSTEM_LIBS=$(LIBSPECTRUM_SYSTEM_LIBS)"
	@echo "PNG=disabled (--without-png)"
	@echo "AUDIO_DRIVER=$(AUDIO_DRIVER) (ahi = native MorphOS ahi.device worker)"
	@echo "VIDEO=surface+overlay+tinygl (CGXVideo/TinyGL optional with fallback)"
	@echo "ALTIVEC=runtime-dispatched ($(ALTIVEC_OBJ), flags: $(ALTIVEC_FLAGS))"
	@echo "DEBUG_BINARY=$(FUSE_DB)"
	@echo "FINAL_BINARY=$(FUSE_BIN)"
	@echo "SYMBOL_MAP=$(FUSE_BUILD)/Fuse.map (generated from Fuse.db with nm -n)"
	@echo "PACKAGE=$(PACKAGE_LHA)"
	@echo "LHA=$(LHA)"
	@echo "CATCOMP=$(CATCOMP)"

# Remove only configure state so the next build re-runs both configure scripts.
reconfigure:
	rm -f "$(LIBSPECTRUM_BUILD)/config.status" "$(LIBSPECTRUM_BUILD)/Makefile" "$(LIBSPECTRUM_PREP)"
	rm -f "$(FUSE_BUILD)/config.status" "$(FUSE_BUILD)/Makefile" "$(FUSE_PREP)"
	rm -f "$(LIBSPECTRUM_PC)"

clean:
	-test ! -f "$(FUSE_BUILD)/Makefile" || $(MAKE) -C "$(FUSE_BUILD)" clean
	-test ! -f "$(LIBSPECTRUM_BUILD)/Makefile" || $(MAKE) -C "$(LIBSPECTRUM_BUILD)" clean
	-rm -f "$(FUSE_PREP)" "$(LIBSPECTRUM_PREP)"
	-rm -f "$(FUSE_DB)" "$(FUSE_BIN)" "$(FUSE_BUILD)/Fuse.map"
	-rm -rf "$(BUNDLE_DIR)" "$(PACKAGE_BUILD)"
	-rm -f "$(PACKAGE_LHA)"

distclean:
	rm -rf "$(DERIVED)" "$(BUNDLE_DIR)"
	rm -f "$(PACKAGE_LHA)"
	rm -f "$(FUSE_AUTOTOOLS_STAMP)"
